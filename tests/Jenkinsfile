pipeline {                     // 전체 Pipeline
    agent any                  // 어느 Node에서 실행할지
    triggers { ... }           // 언제 시작할지 (Poll SCM)
    environment { ... }        // 모든 단계에서 쓰는 환경 변수
    stages {                   // 단계 목록
        stage('이름') {         // 단계 1개
            steps {            // 이 단계에서 실행할 명령
                ...
            }
        }
    }
    post {                     // 모든 단계가 끝난 뒤
        always { ... }         // 성공 · 실패와 관계없이
        failure { ... }        // 실패했을 때만
    }
}

def runCmd(String cmd) {
    if (isUnix()) {
        sh cmd
    } else {
        bat cmd
    }
}

def runCmd(String cmd) {

    if (isUnix()) {
        sh cmd
    } else {
        bat cmd
    }
}

pipeline {
    
    agent any
    
    triggers { 
        pollSCM('H/2 * * * *') // 2분마다 실행
    }    
    
    stages {                   
        stage('Prepare') {         
            steps {            
                script {
                    env.PY = isUnix() ? 'python3' : 'python'
                    env.VPY = isUnix() ? '.ci-venv/bin/python' : '.ci-venv\\Scripts\\python'
                }
                echo "빌드 ${env.BUILD_NUMBER} - 커밋 ${env.GIT_COMMIT}"
            }
        }
        stage('Setup') {       
            steps {            
                // 가상환경
                // sh "python3 -m venv .ci-venv"      
                // bat "python -m venv .ci-venv"        
                runCmd "${env.PY} -m venv .ci-venv"       
                runCmd "${env.VPY} -m pip install -q -r requirements.txt pytest"
            }
        }
        stage('Syntax Check') {       
            steps {            
                // py_complie app.py   deploy.py <- 문법 적용
                runCmd "${env.VPY} -m py_compile app.py deploy.py"       
            }
        }
        stage('Test') {       
            steps {            
                // pytest 실행
                runCmd "${env.VPY} -m pytest -v"
            }
        }
        stage('Deploy') {       
            steps {            
                runCmd "${env.VPY} deploy.py"
            }
        }
    }
    
    // post {                     // 모든 단계가 끝난 뒤
    //    always { ... }         // 성공 · 실패와 관계없이
    //    failure { ... }        // 실패했을 때만
    // }
}